{
  "name": "narration-slides",
  "version": "1.0.0",
  "private": true,
  "description": "台本ファイルから音声・字幕・アニメーション・効果音を自動生成する YouTube 向け解説動画パイプライン (VOICEVOX × Remotion)",
  "scripts": {
    "audio": "tsx scripts/generate-audio.ts",
    "audio:mock": "tsx scripts/generate-audio.ts --mock",
    "script": "tsx scripts/generate-script.ts",
    "sfx": "tsx scripts/generate-sfx.ts",
    "dev": "remotion studio",
    "render": "remotion render Slideshow out/video.mp4",
    "thumbnail": "remotion still Thumbnail out/thumbnail.png",
    "youtube": "tsx scripts/generate-youtube.ts",
    "build:youtube": "npm run render && npm run thumbnail && npm run youtube",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "studio": "tsx studio/server.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@react-three/fiber": "8.18.0",
    "@remotion/bundler": "4.0.533",
    "@remotion/cli": "4.0.533",
    "@remotion/renderer": "4.0.533",
    "@remotion/three": "4.0.533",
    "lucide-react": "^1.52.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.533",
    "three": "0.180.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/three": "0.180.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
